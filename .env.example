# Customer Management API - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# API Configuration
API_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-client-id-here

# Test User Credentials (for development/testing only)
TEST_USERNAME=your-test-username
TEST_PASSWORD=your-secure-password

# AWS Configuration (optional - if not using AWS CLI profiles)
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile-name

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in the .env file
# 3. Load environment variables in PowerShell:
#    Get-Content .env | ForEach-Object {
#        if ($_ -match '^([^=]+)=(.*)$') {
#            [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2])
#        }
#    }
# 4. Or set them manually:
#    $env:API_ENDPOINT = "https://your-api-id.execute-api.us-east-1.amazonaws.com/prod"
#    $env:COGNITO_USER_POOL_ID = "us-east-1_xxxxxxxxx"
#    $env:COGNITO_CLIENT_ID = "your-client-id"
#    $env:TEST_USERNAME = "your-username"
#    $env:TEST_PASSWORD = "your-password"
